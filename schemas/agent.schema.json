{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-marketplace.dev/schemas/agent.schema.json",
  "title": "Agent Manifest",
  "description": "Schema for agent manifests in the Agent Marketplace.",
  "type": "object",
  "required": ["id", "type", "version", "name", "description", "category", "status", "agent"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^agent\\.[0-9]+$",
      "description": "Stable numeric identifier. Never changes even if the agent is renamed.",
      "examples": ["agent.8472916", "agent.1938472"]
    },
    "type": {
      "type": "string",
      "const": "agent",
      "description": "Entity type."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version (MAJOR.MINOR.PATCH).",
      "examples": ["1.0.0", "2.1.3"]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Human-readable display name."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "Short description of the agent's purpose."
    },
    "longDescription": {
      "type": "string",
      "maxLength": 10000,
      "description": "Extended description (optional, for detail views)."
    },
    "category": {
      "type": "string",
      "enum": ["coding", "research", "finance", "productivity", "design", "devops", "development", "marketing", "personal", "sales", "success"],
      "description": "Category for human organization. NOT part of the canonical identity."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "maxLength": 50
      },
      "maxItems": 20,
      "uniqueItems": true,
      "description": "Searchable tags (lowercase, hyphenated)."
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "url": { "type": "string", "format": "uri" }
      },
      "description": "Author information."
    },
    "license": {
      "type": "string",
      "description": "SPDX license identifier.",
      "examples": ["MIT", "Apache-2.0", "proprietary"]
    },
    "homepage": {
      "type": "string",
      "format": "uri",
      "description": "Agent homepage or documentation URL."
    },
    "status": {
      "type": "string",
      "enum": ["active", "hidden", "deprecated", "revoked"],
      "description": "Visibility and lifecycle status."
    },
    "media": {
      "$ref": "#/$defs/media"
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "instructions"],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "The agent's role definition."
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50000,
          "description": "System instructions for the agent."
        },
        "models": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "primary": {
              "type": "string",
              "description": "Primary model identifier (e.g. 'claude-sonnet-4', 'gpt-4o')."
            },
            "fallback": {
              "type": "array",
              "items": { "type": "string" },
              "maxItems": 5,
              "description": "Fallback models in preference order."
            },
            "config": {
              "type": "object",
              "additionalProperties": true,
              "description": "Model-specific configuration (temperature, max_tokens, etc.)."
            }
          },
          "description": "Model configuration."
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string",
                "description": "Tool identifier."
              },
              "description": {
                "type": "string",
                "maxLength": 500,
                "description": "What this tool does."
              },
              "required": {
                "type": "boolean",
                "default": false,
                "description": "Whether this tool is required (vs optional)."
              }
            }
          },
          "maxItems": 50,
          "description": "Tools the agent needs access to."
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.]*$"
          },
          "maxItems": 30,
          "uniqueItems": true,
          "description": "Requested permissions (e.g. 'fs.read', 'network.api', 'memory.write')."
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "Whether the agent uses persistent memory."
            },
            "scope": {
              "type": "string",
              "enum": ["session", "user", "workspace"],
              "default": "session",
              "description": "Memory scope."
            },
            "description": {
              "type": "string",
              "maxLength": 1000,
              "description": "What the agent remembers."
            }
          },
          "description": "Memory configuration."
        },
        "automations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "description"],
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 100,
                "description": "Automation name."
              },
              "description": {
                "type": "string",
                "maxLength": 500,
                "description": "What this automation does."
              },
              "trigger": {
                "type": "string",
                "description": "What triggers this automation."
              }
            }
          },
          "maxItems": 20,
          "description": "Built-in automations."
        }
      },
      "description": "Agent runtime configuration."
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minPlatformVersion": {
          "type": "string",
          "description": "Minimum platform version required."
        },
        "maxPlatformVersion": {
          "type": "string",
          "description": "Maximum platform version supported."
        },
        "requiredFeatures": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 20,
          "description": "Platform features this agent requires."
        }
      },
      "description": "Platform compatibility constraints."
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Integration name (e.g. 'GitHub', 'Slack', 'Gmail')."
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Integration homepage URL."
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "description": "What this integration provides."
          }
        }
      },
      "maxItems": 20,
      "uniqueItems": true,
      "description": "External services this agent integrates with."
    }
  },
  "$defs": {
    "media": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "icon": {
          "type": "object",
          "additionalProperties": false,
          "required": ["src"],
          "properties": {
            "src": {
              "type": "string",
              "pattern": "^(icon\\.svg|media/icon\\.(svg|png|webp))$",
              "description": "Icon file path (relative to manifest)."
            },
            "alt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Accessible alt text for the icon."
            }
          },
          "description": "Agent icon."
        },
        "hero": {
          "type": "object",
          "additionalProperties": false,
          "required": ["src", "alt"],
          "properties": {
            "src": {
              "type": "string",
              "pattern": "^media/[a-z0-9-]+\\.(webp|avif|png|jpg)$",
              "description": "Hero image path."
            },
            "alt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "Accessible alt text for the hero image."
            }
          },
          "description": "Main showcase image."
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["src", "alt", "order"],
            "properties": {
              "src": {
                "type": "string",
                "pattern": "^media/[a-z0-9-]+\\.(webp|avif|png|jpg)$",
                "description": "Image path."
              },
              "alt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300,
                "description": "Accessible alt text."
              },
              "order": {
                "type": "integer",
                "minimum": 0,
                "description": "Display order (deterministic, lower first)."
              }
            }
          },
          "maxItems": 20,
          "description": "Additional showcase images. Order is deterministic."
        }
      },
      "description": "Media assets for the agent."
    }
  }
}
